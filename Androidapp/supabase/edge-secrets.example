# Reference only: do not deploy these placeholder values and never commit real values.
# Replace the values in Supabase Dashboard > Edge Functions > Secrets before production.
GEMINI_API_KEY=__REPLACE_BEFORE_PRODUCTION__
OPENROUTER_API_KEY=__REPLACE_BEFORE_PRODUCTION__
COHERE_API_KEY=__REPLACE_BEFORE_PRODUCTION__
POLLINATIONS_API_KEY=__REPLACE_BEFORE_PRODUCTION__
PAYHERO_API_USERNAME=__REPLACE_BEFORE_PRODUCTION__
PAYHERO_API_PASSWORD=__REPLACE_BEFORE_PRODUCTION__
PAYHERO_CHANNEL_ID=0
PAYPAL_CLIENT_ID=__REPLACE_BEFORE_PRODUCTION__
PAYPAL_CLIENT_SECRET=__REPLACE_BEFORE_PRODUCTION__
PAYPAL_MODE=sandbox
# Optional:
PAYPAL_RETURN_URL=https://YOUR_DEPLOYED_APP/payment/success
PAYPAL_CANCEL_URL=https://YOUR_DEPLOYED_APP/payment/cancel
# PayNexus is intentionally not listed until callback authentication and payment verification are documented.
# SUPABASE_URL, SUPABASE_ANON_KEY / SUPABASE_PUBLISHABLE_KEYS, and
# SUPABASE_SERVICE_ROLE_KEY / SUPABASE_SECRET_KEYS are platform-managed defaults.
