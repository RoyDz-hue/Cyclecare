<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostic-debug isolation: remove the production auth callback intent-filter so
     an installed debug build cannot compete with the production app for
     cyclecare://auth/callback. Consequence: OAuth sign-in cannot complete in the
     debug diagnostic (no redirect lands) — intentional; diagnostics must not run
     real auth against a production account. Prepared locally for review; not a
     handoff authorization. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity android:name=".MainActivity">
            <intent-filter android:autoVerify="false"
                tools:node="remove">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="cyclecare"
                    android:host="auth"
                    android:pathPrefix="/callback" />
            </intent-filter>
        </activity>
    </application>

</manifest>
