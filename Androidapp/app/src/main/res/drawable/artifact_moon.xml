        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="30"
                android:endX="140"
                android:endY="180">
                <item android:offset="0.0" android:color="#FFF8E1" />
                <item android:offset="0.3" android:color="#E0A728" />
                <item android:offset="0.7" android:color="#9E6B0C" />
