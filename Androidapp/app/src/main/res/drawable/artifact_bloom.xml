<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Petal 1: Top -->
    <path
        android:pathData="M100,100 C80,70 65,35 100,25 C135,35 120,70 100,100 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="80"
                android:startY="30"
                android:endX="120"
                android:endY="95">
                <item android:offset="0.0" android:color="#FDE8E3" />
                <item android:offset="0.4" android:color="#F4C2B8" />
                <item android:offset="1.0" android:color="#D89286" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Petal 2: Top Right -->
    <path
        android:pathData="M100,100 C125,80 165,70 172,105 C160,135 125,120 100,100 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="110"
                android:startY="75"
                android:endX="165"
                android:endY="120">
                <item android:offset="0.0" android:color="#FDE8E3" />
                <item android:offset="0.4" android:color="#F0B7AB" />
                <item android:offset="1.0" android:color="#CF877B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Petal 3: Bottom Right -->
    <path
        android:pathData="M100,100 C115,125 140,165 110,175 C85,165 90,125 100,100 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="125"
                android:startY="110"
                android:endX="95"
                android:endY="170">
                <item android:offset="0.0" android:color="#FDE8E3" />
                <item android:offset="0.5" android:color="#EAAFA3" />
                <item android:offset="1.0" android:color="#C67C6F" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Petal 4: Bottom Left -->
    <path
        android:pathData="M100,100 C80,120 45,155 35,125 C45,95 80,100 100,100 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="90"
                android:startY="100"
                android:endX="40"
                android:endY="140">
                <item android:offset="0.0" android:color="#FDE8E3" />
                <item android:offset="0.5" android:color="#F2BBB0" />
                <item android:offset="1.0" android:color="#C78074" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Petal 5: Top Left -->
    <path
        android:pathData="M100,100 C75,80 35,65 50,35 C80,45 85,80 100,100 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="95"
                android:startY="90"
                android:endX="45"
                android:endY="45">
                <item android:offset="0.0" android:color="#FDE8E3" />
                <item android:offset="0.4" android:color="#F4C0B6" />
                <item android:offset="1.0" android:color="#CE887C" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Golden Stamen Ring (Base setting) -->
    <path
        android:pathData="M100,100m-20,0a20,20 0,1 1,40 0a20,20 0,1 1,-40 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="100"
                android:centerY="100"
                android:gradientRadius="20">
                <item android:offset="0.0" android:color="#FFF8E1" />
                <item android:offset="0.4" android:color="#F5C756" />
                <item android:offset="0.8" android:color="#C78F1E" />
                <item android:offset="1.0" android:color="#785006" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Radiating Stamen Filaments -->
    <path
        android:pathData="M100,82 L100,86 M100,114 L100,118 M82,100 L86,100 M114,100 L118,100 M87,87 L90,90 M110,110 L113,113 M87,113 L90,110 M110,90 L113,87"
        android:strokeWidth="2.5"
        android:strokeColor="#FFECB3"
        android:strokeLineCap="round" />

    <!-- Center Pearl Jewel Core -->
    <path
        android:pathData="M100,100m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="96"
                android:centerY="95"
                android:gradientRadius="12">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.3" android:color="#FFF9C4" />
                <item android:offset="0.7" android:color="#F8C447" />
                <item android:offset="1.0" android:color="#C08417" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
