# Deployment/CLI configuration only. Android reads .env.android, which must contain only
# SUPABASE_URL and SUPABASE_ANON_KEY. Never put service-role, management, GitHub, or AI
# provider secrets in an Android environment file or mobile build.

# Supabase Management API Personal Access Token (server/deployment tooling only)
SUPABASE_ACCESS_TOKEN=your_supabase_pat_here

# Supabase project URL and public client key (safe to include in client builds)
SUPABASE_URL=https://apjqcocxtylsofgxhetb.supabase.co
SUPABASE_ANON_KEY=sb_publishable_ziAlyPmKSv7kQZjbpbIuwA_6er-NufM

# Optional GitHub deployment tooling (server/local use only)
GITHUB_PAT=your_github_personal_access_token_here
GITHUB_REPO_URL=https://github.com/your-org/your-repository.git

# Set the Gemini provider key only as a Supabase Edge Function secret:
# supabase secrets set GEMINI_API_KEY=...
