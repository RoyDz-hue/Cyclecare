<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="200dp"
    android:height="200dp"
    android:viewportWidth="200"
    android:viewportHeight="200">

    <!-- Outer Rim Shadow / Drop Shadow -->
    <path
        android:pathData="M100,100m-88,0a88,88 0,1 1,176 0a88,88 0,1 1,-176 0"
        android:fillColor="#15000000" />

    <!-- Coin Bevel Outer Ring -->
    <path
        android:pathData="M100,100m-82,0a82,82 0,1 1,164 0a82,82 0,1 1,-164 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="20"
                android:startY="20"
                android:endX="180"
                android:endY="180">
                <item android:offset="0.0" android:color="#FFF8E1" />
                <item android:offset="0.25" android:color="#F3C653" />
                <item android:offset="0.5" android:color="#C68C1C" />
                <item android:offset="0.75" android:color="#E5B23A" />
                <item android:offset="1.0" android:color="#8A5A05" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Coin Mid Rim Step -->
    <path
        android:pathData="M100,100m-72,0a72,72 0,1 1,144 0a72,72 0,1 1,-144 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="180"
                android:startY="30"
                android:endX="20"
                android:endY="170">
                <item android:offset="0.0" android:color="#FFE685" />
                <item android:offset="0.3" android:color="#F5B82E" />
                <item android:offset="0.7" android:color="#9E6B0C" />
                <item android:offset="1.0" android:color="#E0A728" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Coin Field -->
    <path
        android:pathData="M100,100m-65,0a65,65 0,1 1,130 0a65,65 0,1 1,-130 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="90"
                android:centerY="85"
                android:gradientRadius="75">
                <item android:offset="0.0" android:color="#FFF3C4" />
                <item android:offset="0.4" android:color="#F2C558" />
                <item android:offset="0.8" android:color="#C58B1B" />
                <item android:offset="1.0" android:color="#A06909" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Embossed Inner Groove Ring -->
    <path
        android:pathData="M100,100m-61,0a61,61 0,1 1,122 0a61,61 0,1 1,-122 0"
        android:strokeWidth="1.5"
        android:strokeColor="#784E03" />
    <path
        android:pathData="M100,100m-60,0a60,60 0,1 1,120 0a60,60 0,1 1,-120 0"
        android:strokeWidth="1.5"
        android:strokeColor="#FFE896" />

    <!-- Crescent Moon Shadow (Emboss depth) -->
    <path
        android:pathData="M112,60 C80,60 62,82 62,102 C62,124 82,142 112,142 C92,132 82,118 82,102 C82,84 94,70 112,60 Z"
        android:fillColor="#5A3A02" />

    <!-- Crescent Moon Highlight (Emboss top light) -->
    <path
        android:pathData="M110,58 C78,58 60,80 60,100 C60,122 80,140 110,140 C90,130 80,116 80,100 C80,82 92,68 110,58 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="60"
                android:startY="60"
                android:endX="110"
                android:endY="140">
                <item android:offset="0.0" android:color="#FFFFFF" />
                <item android:offset="0.3" android:color="#FFECA3" />
                <item android:offset="0.7" android:color="#E0A728" />
                <item android:offset="1.0" android:color="#8C5C06" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular Highlight Arc -->
    <path
        android:pathData="M45,70 C55,45 80,30 110,28"
        android:strokeWidth="3.5"
        android:strokeColor="#80FFFFFF"
        android:strokeLineCap="round" />

</vector>
